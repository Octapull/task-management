<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>a4c817cd-5dc4-4188-8378-1f01f25b7e6a</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="Dapper" Version="2.1.79" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Şema ve migration'lar imaja gömülüyor: DatabaseMigrator bunları
         diskten değil derlenmiş derlemenin içinden okuyor, böylece
         yayınlanmış uygulamanın yanında ayrı bir SQL klasörü taşımak
         gerekmiyor.

         seed.sql bilerek DIŞARIDA: demo verisi uygulamanın açılışta
         yapacağı bir iş değil, elle çalıştırılan bir script. -->
    <EmbeddedResource Include="Database\schema.sql" />
    <EmbeddedResource Include="Database\migrations\*.sql" />
  </ItemGroup>

  <ItemGroup>
    <!-- Kod üretimi gibi iç yardımcılar dışarıya açılmadan test edilebilsin. -->
    <InternalsVisibleTo Include="TaskManagementSystem.Tests" />
  </ItemGroup>

</Project>
