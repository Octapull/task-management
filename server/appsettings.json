{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // --- Sırlar bu dosyada TUTULMAZ ------------------------------------------
  // Bu dosya git'te takipli, yani buraya yazılan her şey commit'e girer.
  // Şifreler ve anahtarlar User Secrets'ta duruyor (repo dışında,
  // %APPDATA%\Microsoft\UserSecrets\ altında) ve bu dosyadaki boş değerleri
  // ezerler. Yeni bir makinede kurulum:
  //
  //   cd server
  //   dotnet user-secrets set "ConnectionStrings:DefaultConnection" "Host=localhost;Port=5432;Database=taskmanagementsystem;Username=postgres;Password=SIFRE"
  //   dotnet user-secrets set "Jwt:Key" "<32 baytlık rastgele base64 - ör. openssl rand -base64 32>"
  //
  // Production'da aynı değerler ortam değişkeni olarak verilir.

  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Database": {
    // Açılışta şema kontrol edilsin mi?
    //
    // Açıkken: veritabanı boşsa schema.sql uygulanır, doluysa yalnızca
    // Database/migrations/ altındaki eksik dosyalar sırayla çalışır.
    // Uygulanan her dosya schema_migrations tablosuna yazılır, bu yüzden
    // ikinci açılışta hiçbir şey tekrar çalışmaz.
    //
    // Şemayı ayrı bir dağıtım adımında (ör. CI'da migration job'ı)
    // yönetiyorsan false yap.
    "AutoMigrate": true
  },
  "Jwt": {
    // İmzalama anahtarı. Sızarsa herkes kendine geçerli token üretebilir,
    // bu yüzden burada değil User Secrets'ta duruyor.
    "Key": "",
    "Issuer": "TaskManagementSystem",
    "Audience": "TaskManagementSystemUsers",
    // Erişim token'ının ömrü. Kısa tutuluyor: JWT sunucuda saklanmadığı için
    // iptal edilemiyor, çalınırsa süresi dolana kadar geçerli kalıyor.
    "ExpiryMinutes": 60,
    // Yenileme token'ının ömrü. Kullanıcı bu süre boyunca hiç giriş ekranı
    // görmüyor; erişim token'ı bittikçe arka planda sessizce yenileniyor.
    // Bu token veritabanında durduğu için iptal EDİLEBİLİYOR - uzun ömür
    // burada güvenlik sorunu değil.
    "RefreshTokenDays": 14
  },
  "Storage": {
    // Ek dosyalarının klasörü. wwwroot'un ALTINDA olmamalı: orası kimlik
    // doğrulaması olmadan sunuluyor.
    "AttachmentsPath": "App_Data/attachments",
    "MaxFileSizeMb": 10
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Email": {
    // "Mock"   = posta gönderilmez, kod loga yazılır ve API yanıtında döner.
    // "Resend" = Resend'in HTTPS API'siyle gönderilir (Email:Resend altı).
    // "Smtp"   = SMTP ile gönderilir (Email:Smtp altı). Dikkat: bulut
    //            sağlayıcılarının çoğu giden 25/465/587'yi engelliyor,
    //            öyle bir ortamda "Resend" kullan.
    "Provider": "Mock",
    "FromAddress": "noreply@istakip.local",
    "FromName": "İş Takip",
    "CodeLifetimeMinutes": 10,
    "ResendCooldownSeconds": 60,
    // Bildirimler. Geliştirirken posta kutusu dolmasın diye ikisi de
    // kapatılabilir; NotifyOnDueDate kapalıyken tarama hiç çalışmaz.
    "NotifyOnAssignment": true,
    "NotifyOnDueDate": true,
    "DueSoonHours": 24,
    "ReminderScanMinutes": 30,
    "AppUrl": "http://localhost:4200",
    "Resend": {
      // Anahtar User Secrets'tan ya da Email__Resend__ApiKey ortam
      // değişkeninden geliyor - buraya yazılırsa commit'e girer.
      "ApiKey": "",
      "BaseUrl": "https://api.resend.com",
      "TimeoutSeconds": 15
    },
    "Smtp": {
      // Kullanıcı adı ve şifre User Secrets'tan geliyor.
      "Host": "",
      "Port": 587,
      "EnableSsl": true,
      "UserName": "",
      "Password": "",
      "TimeoutSeconds": 15
    }
  }
}
