# Bu dosyayı .env olarak kopyala ve değerleri doldur. .env git'te takipli
# değil; docker compose onu kendiliğinden okuyor.
#
#   cp .env.example .env

# --- Veritabanı --------------------------------------------------------------
POSTGRES_DB=taskmanagementsystem
POSTGRES_USER=postgres
# Zorunlu. Konteyner ilk açılışta veritabanını bu şifreyle kuruyor; sonradan
# değiştirirsen db-data volume'ünü de silmen gerekir.
POSTGRES_PASSWORD=

# --- JWT ---------------------------------------------------------------------
# Zorunlu. 32 baytlık rastgele değer:
#   openssl rand -base64 32
# PowerShell'de:
#   [Convert]::ToBase64String((1..32 | % { Get-Random -Max 256 }))
# Sızarsa herkes kendine geçerli token üretebilir.
JWT_KEY=

# --- E-posta -----------------------------------------------------------------
# Mock = posta gönderilmez, doğrulama kodu konteyner loguna yazılır:
#   docker compose logs -f server
# Smtp = aşağıdaki bilgilerle gerçekten gönderilir.
EMAIL_PROVIDER=Mock
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Portlar (host tarafı) ---------------------------------------------------
CLIENT_PORT=4200
SERVER_PORT=5208
# Makinede zaten PostgreSQL çalışıyor olabilir diye 5432 değil.
DB_PORT=5433

# --- Ortam -------------------------------------------------------------------
# Development: Swagger açık, HTTPS yönlendirmesi kapalı (konteynerde TLS yok).
# Production'a çekersen TLS'i en dıştaki reverse proxy'de sonlandır.
ASPNETCORE_ENVIRONMENT=Development
